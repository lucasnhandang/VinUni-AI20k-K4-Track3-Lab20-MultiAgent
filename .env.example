# LLM Provider Configuration:
# Option A: OpenRouter (Recommended for multi-model flexibility)
OPENROUTER_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Option B: Direct OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Search Provider (Tavily)
TAVILY_API_KEY=

# Optional Tracing Providers
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research-lab
# Dùng dòng dưới nếu tài khoản của bạn ở vùng APAC (apac.smith.langchain.com):
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Runtime config
APP_ENV=local
LOG_LEVEL=INFO
MAX_ITERATIONS=6
TIMEOUT_SECONDS=60

